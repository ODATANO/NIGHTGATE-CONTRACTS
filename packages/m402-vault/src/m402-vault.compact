// m402 payment vault: NIGHT pooled in the contract, a shielded credit minted 1:1.
// Coins and secrets are circuit parameters, so a caller needs no witness of its own.

// Modified from m402 (https://github.com/julianariel/m402), Apache-2.0.
// Copyright 2026 The m402 contributors. Changed: witnesses became circuit parameters.
pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger servicePrice:    Map<Bytes<32>, Uint<64>>;
export ledger serviceOwner:    Map<Bytes<32>, Bytes<32>>;
export ledger receipts:        Set<Bytes<32>>;
export ledger merchantBalance: Map<Bytes<32>, Uint<64>>;
export ledger mintCounter:     Counter;

pure circuit creditDomain(): Bytes<32> { return pad(32, "m402:credit:v1"); }

// The colour of this vault's credit, derivable off-chain with no proof; `self` is the
// vault's address (a pure circuit has no ledger access).
export pure circuit creditColor(self: ContractAddress): Bytes<32> {
  return tokenType(creditDomain(), self);
}

// The redemption credential and the selective-disclosure opening: the payer keeps
// the secret, the chain sees only this hash.
export pure circuit deriveReceipt(secret: Bytes<32>, serviceId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "m402:receipt:v1"), secret, serviceId]
  );
}

// The service id binds owner, salt and price: a front-runner can copy none of them
// without landing on another id.
export pure circuit deriveServiceId(
  owner: Bytes<32>,
  salt: Bytes<32>,
  price: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "m402:sid:v1"), owner, salt, price as Bytes<32>]
  );
}

export circuit registerService(salt: Bytes<32>, price: Uint<64>, owner: Bytes<32>): [] {
  assert(price > 0, "price must be positive");
  assert(owner != pad(32, ""), "owner must be set");

  const serviceId = deriveServiceId(disclose(owner), disclose(salt), disclose(price));
  // first come, immutable: neither map may be overwritten
  assert(!servicePrice.member(serviceId), "already registered");
  assert(!serviceOwner.member(serviceId), "already registered");

  servicePrice.insert(serviceId, disclose(price));
  serviceOwner.insert(serviceId, disclose(owner));
}

// Unshielded NIGHT in, shielded credit out to the caller's own key. `nonceSeed` is
// fresh random bytes from the caller: it hides which deposit funded which payment.
export circuit deposit(amount: Uint<64>, nonceSeed: Bytes<32>): [] {
  assert(amount > 0, "amount must be positive");
  receiveUnshielded(nativeToken(), disclose(amount) as Uint<128>);

  const nonce = disclose(evolveNonce(mintCounter as Field as Uint<64>, nonceSeed));
  const coin = mintShieldedToken(
    creditDomain(),
    disclose(amount),
    nonce,
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
  // the caller's key as the destination is sound: a lie misdirects only its own deposit
  sendImmediateShielded(
    coin,
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    coin.value
  );
  mintCounter.increment(1);
}

// Pays a service with one credit coin of exactly its price; `receiptSecret` is the
// payer's fresh random credential, only its hash goes on chain.
export circuit pay(serviceId: Bytes<32>, credit: ShieldedCoinInfo, receiptSecret: Bytes<32>): [] {
  const sid = disclose(serviceId);
  assert(servicePrice.member(sid), "unknown service");
  const price = servicePrice.lookup(sid);

  // receiveShielded does not constrain the colour: a self-minted token must not pay
  assert(credit.color == tokenType(creditDomain(), kernel.self()), "not an m402 credit");
  // the whole coin is consumed and only the price credited: an overpaying coin burns the rest
  assert(credit.value == price as Uint<128>, "wrong amount");

  const receipt = deriveReceipt(receiptSecret, sid);
  assert(!receipts.member(disclose(receipt)), "receipt reused");

  receiveShielded(disclose(credit));
  receipts.insert(disclose(receipt));

  const owner = serviceOwner.lookup(sid);
  const prior = merchantBalance.member(owner) ? merchantBalance.lookup(owner) : 0 as Uint<64>;
  merchantBalance.insert(owner, (prior + price) as Uint<64>);
}

// Cashes a credit coin back to NIGHT. Holding the coin is the authorisation (Zswap
// validates the spend), so the caller names any recipient for its own funds.
export circuit redeem(recipient: Bytes<32>, credit: ShieldedCoinInfo): [] {
  assert(recipient != pad(32, ""), "recipient must be set");

  assert(credit.color == tokenType(creditDomain(), kernel.self()), "not an m402 credit");
  assert(credit.value > 0, "nothing to redeem");

  receiveShielded(disclose(credit));
  sendUnshielded(
    nativeToken(),
    disclose(credit.value),
    right<ContractAddress, UserAddress>(UserAddress { bytes: disclose(recipient) })
  );
}

export circuit withdraw(serviceId: Bytes<32>, amount: Uint<64>): [] {
  const sid = disclose(serviceId);
  // a zero amount would be a free way to contend on merchantBalance
  assert(amount > 0, "amount must be positive");
  assert(serviceOwner.member(sid), "unknown service");
  const owner = serviceOwner.lookup(sid);

  assert(merchantBalance.member(owner), "no balance");
  const balance = merchantBalance.lookup(owner);
  assert(balance >= disclose(amount), "insufficient balance");

  // no caller check: the destination comes from the ledger, whoever submits
  sendUnshielded(
    nativeToken(),
    disclose(amount) as Uint<128>,
    right<ContractAddress, UserAddress>(UserAddress { bytes: owner })
  );

  merchantBalance.insert(owner, (balance - disclose(amount)) as Uint<64>);
}
