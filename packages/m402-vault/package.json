{
    "name": "@odatano/contract-m402-vault",
    "version": "0.1.1",
    "description": "m402 payment vault Compact contract: NIGHT pooled against a shielded credit, services paid in private, receipts checked in the public ledger.",
    "license": "Apache-2.0",
    "author": "ODATANO",
    "homepage": "https://github.com/ODATANO/NIGHTGATE-CONTRACTS#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODATANO/NIGHTGATE-CONTRACTS.git",
        "directory": "packages/m402-vault"
    },
    "keywords": [
        "midnight",
        "compact",
        "nightgate",
        "payment",
        "m402"
    ],
    "type": "module",
    "main": "./managed/m402-vault/contract/index.js",
    "types": "./managed/m402-vault/contract/index.d.ts",
    "exports": {
        ".": {
            "types": "./managed/m402-vault/contract/index.d.ts",
            "default": "./managed/m402-vault/contract/index.js"
        },
